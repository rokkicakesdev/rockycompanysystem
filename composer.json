{
    "name": "rocky-company/hris-payroll",
    "description": "Rocky Company HRIS and Payroll System",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "phpoffice/phpspreadsheet": "^5.5",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "RockyCompany\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RockyCompany\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test:coverage": "phpunit --coverage-text"
    }
}
