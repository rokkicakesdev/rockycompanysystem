# Rocky Company HRIS — Apache Security Rules

# ── Force HTTPS ───────────────────────────────────────────────────────────────
# HOW TO ENABLE FOR PRODUCTION:
#   Set APP_ENV=production in .env, ensure valid SSL cert, then uncomment below.
#   On localhost/XAMPP: keep commented — HTTP is fine for local dev.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Disable directory listing ─────────────────────────────────────────────────
Options -Indexes

# ── Block direct access to sensitive file types ───────────────────────────────
<FilesMatch "\.(env|log|sql|sh|bak|swp|map)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block dotfiles and markdown
<FilesMatch "^(\.gitignore|\.gitattributes|README\.md|CHANGELOG\.md|LICENSE\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Block access to specific sensitive PHP utility files ──────────────────────
<FilesMatch "^(reset_password|clear_session)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Block direct access to sensitive directories ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/.*$   - [F,L]
    RewriteRule ^core/.*$     - [F,L]
    RewriteRule ^database/.*$ - [F,L]
    RewriteRule ^vendor/.*$   - [F,L]
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# ── Security Headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    # HSTS — only effective on HTTPS. Safe to keep; browsers ignore on HTTP.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── PHP error display ─────────────────────────────────────────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
