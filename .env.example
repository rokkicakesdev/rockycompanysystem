# .env.example
# Copy this file to .env and fill in your real values
# Never commit your actual .env file!

# ── Database Connection ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ── Application Settings ───────────────────────────────────────
APP_ENV=development              # change to production on live server
APP_NAME=
APP_VERSION=

# ── URLs & Paths ───────────────────────────────────────────────
BASE_URL=
ASSETS_URL=/assets

# ── Company Info ───────────────────────────────────────────────
COMPANY_NAME=
COMPANY_ADDRESS=

# ── Business Rules ─────────────────────────────────────────────
WORKING_DAYS=22
WORK_HOURS=8
RECORDS_PER_PAGE=15

# ── Security / Optional (uncomment and set when needed) ────────
# APP_SECRET=

# ── Mail / SMTP Configuration ───────────────────────────────────
# Leave MAIL_HOST empty to use PHP's built-in mail() function.
# For Gmail: set MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
# and use a Gmail App Password (not your regular password).
MAIL_FROM_ADDRESS=noreply@rockycompany.com
MAIL_FROM_NAME=Rocky HRIS
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls