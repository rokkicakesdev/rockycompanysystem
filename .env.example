# .env.example
# Copy this file to .env and fill in your real values
# Never commit your actual .env file!

# ──────────────────────────────────────────────────────────────
# Database connection (required)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
APP_ENV=development

# Optional – uncomment and set as needed
# APP_SECRET=
# COMPANY_NAME=
# COMPANY_ADDRESS=